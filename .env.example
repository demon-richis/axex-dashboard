# Neon Postgres HTTP connection string for dashboard queries and rate limits.
DATABASE_URL=
# Random signing key; must contain at least 32 characters.
SESSION_SECRET=
# Discord OAuth application credentials. Request the identify scope only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Exact callback URL registered in the Discord Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Link used for the "Add Axex" action; the dashboard must never hold a bot token.
BOT_INVITE_URL=https://discord.com/oauth2/authorize
# Optional HTTPS bot /health endpoint for the public status page. Keep server-side.
AXEX_BOT_HEALTH_URL=
# Public canonical origin, for example https://dashboard.example.com.
PUBLIC_URL=http://localhost:3000
